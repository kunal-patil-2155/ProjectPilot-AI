# ProjectPilot AI Configuration
PORT=3000
NODE_ENV=development

# MCP Authentication & Mutation Guard
# Set MCP_API_KEY to enforce token-based authentication on /mcp (Bearer token or x-api-key)
# Mandatory for state-mutating operations in production (NODE_ENV=production)
# When unset or empty in development mode, open local operations are permitted
MCP_API_KEY=your-mcp-secret-key-placeholder

# Durable Serverless Persistence (Upstash Redis REST)
# Required in production (NODE_ENV=production or Vercel serverless functions) for multi-instance persistence
# Free tier endpoint and token from https://console.upstash.com/
# When unset, the server defaults to local atomic JSON file storage (data/store.json)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-placeholder
UPSTASH_REDIS_STORE_KEY=projectpilot:store

# Extended MCP Tools
# Set to 'true' to enable extended project management tools (Groups A-G, tools 13-20)
PROJECTPILOT_EXTENDED_TOOLS=true

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://myapp.com,https://developer.amazon.com)
# When unset or empty, defaults to local development origins (localhost, 127.0.0.1)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
# Maximum requests allowed per IP address per minute (default: 120)
RATE_LIMIT_MAX_PER_MINUTE=120
