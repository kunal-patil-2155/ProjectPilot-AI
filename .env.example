# ProjectPilot AI Configuration
PORT=3000
NODE_ENV=development

# MCP Authentication
# Set MCP_API_KEY to enforce token-based authentication on /mcp (Bearer token or x-api-key)
# When unset or empty, the server operates in open local development mode
MCP_API_KEY=your-mcp-secret-key-placeholder

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://myapp.com,https://developer.amazon.com)
# When unset or empty, defaults to local development origins (localhost, 127.0.0.1)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
# Maximum requests allowed per IP address per minute (default: 120)
RATE_LIMIT_MAX_PER_MINUTE=120
